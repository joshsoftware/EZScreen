# Copy to apps/frontend/.env — do not commit .env.
# Docker Compose loads this file via env_file (see docker-compose.yml).
#
# Leave empty so the browser calls /api on the same host (Vite proxy or Nginx).
VITE_CORE_API_URL=

# Optional WebSocket screening URL (if used).
# VITE_AI_SCREENING_URL=ws://localhost:8002
