# Copy to apps/core-api/.env — do not commit .env.
# Docker Compose loads this file via env_file (see docker-compose.yml).

# --- Native run (Python on host) ---
# DATABASE_URL=postgresql+psycopg2://ezscreen_user:CHANGE_ME@127.0.0.1:5432/ezscreen_db
# MINIO_ENDPOINT=127.0.0.1:9000
# AI_SERVICES_HOST=127.0.0.1

# --- Docker Compose ---
# Use Compose Postgres (db:5432). If you use host Postgres instead:
#   postgresql+psycopg2://USER:PASS@host.docker.internal:5432/ezscreen_db
# Encode @ in the password as %40.
DATABASE_URL=postgresql+psycopg2://ezscreen_user:ezscreen_password@db:5432/ezscreen_db

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173

# Presigned upload/preview URLs are opened in the BROWSER.
# Must be reachable from the browser (not Docker DNS "minio").
# Local Compose: 127.0.0.1:9000 or host.docker.internal:9000
# Staging: public IP/hostname, e.g. 13.201.101.39:9000
# Separate from AI_SERVICES_HOST unless MinIO is on that same host.
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_password
MINIO_SECURE=false
MINIO_BUCKET_RESUMES=resumes

# Host of AI core (JD parse, resume parse, job-fit). Port 8002, path /internal/v1.
# Compose overrides this to ai-core-services (Docker DNS).
AI_SERVICES_HOST=127.0.0.1
AI_SERVICES_PORT=8002
# Optional full URL override. If set, host/port above are ignored.
# PARSING_SERVICE_URL=http://127.0.0.1:8002/internal/v1

# Invite / outbound email. console = log invite body in core-api logs.
EMAIL_MODE=console
EMAIL_FROM=noreply@ezscreen.io

# Google Meet join links only (no Calendar events).
# mock = placeholder Meet URL (default for local)
# live = real Meet space via Google Meet Spaces API
GOOGLE_MEET_MODE=mock
# Service account (Workspace + domain-wide delegation):
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
# GOOGLE_MEET_DELEGATED_USER=scheduler@yourdomain.com
# Or OAuth refresh token (run: python -m scripts.google_oauth_refresh_token):
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
