# Copy to apps/core-api/.env — do not commit .env.
# Docker Compose loads this file via env_file (see docker-compose.yml).

# --- Native run (Python on host) ---
# DATABASE_URL=postgresql+psycopg2://ezscreen_user:CHANGE_ME@127.0.0.1:5432/ezscreen_db
# MINIO_ENDPOINT=127.0.0.1:9000
# AI_SERVICES_HOST=127.0.0.1

# --- Docker Compose ---
# Postgres container (db service) reads POSTGRES_* below.
# DATABASE_URL password must match POSTGRES_PASSWORD (encode special chars, e.g. ! as %21).
POSTGRES_USER=ezscreen_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ezscreen_db
# Host port for db publish (docker-compose.yml). Staging example: 5433
POSTGRES_HOST_PORT=5434
DATABASE_URL=postgresql+psycopg2://ezscreen_user:CHANGE_ME@db:5432/ezscreen_db

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173

# Presigned upload/preview URLs are opened in the BROWSER (not Docker DNS "minio").
# Local Compose: MINIO_ENDPOINT=127.0.0.1:9002
#
# Staging (only ports 22/80/443 open):
#   MINIO_ENDPOINT=ezscreen.joshsoftware.com
#   MINIO_INTERNAL_ENDPOINT=minio:9000
#   Nginx: proxy /resumes/ and /jds/ → 127.0.0.1:9000 (docs/staging/nginx-ezscreen.conf)
#   MinIO env: MINIO_SERVER_URL=http://ezscreen.joshsoftware.com
MINIO_ENDPOINT=127.0.0.1:9000
# Server-side get_object (preview/download proxy). Docker: minio:9000
# MINIO_INTERNAL_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=CHANGE_ME
MINIO_SECURE=false
MINIO_BUCKET_RESUMES=resumes

# Host of AI core (JD parse, resume parse, job-fit). Port 8002, path /internal/v1.
# Compose overrides this to ai-core-services (Docker DNS).
AI_SERVICES_HOST=127.0.0.1
AI_SERVICES_PORT=8002
# Optional full URL override. If set, host/port above are ignored.
# PARSING_SERVICE_URL=http://127.0.0.1:8002/internal/v1

# Shared secret for ai-core-services → core-api screening callbacks.
# When set, callers must send header: X-Internal-Service-Token: <value>
# Generate: openssl rand -hex 32
# Must match INTERNAL_SERVICE_TOKEN in services/ai-core-services/.env
INTERNAL_SERVICE_TOKEN=CHANGE_ME

# Invite / outbound email. console = log invite body in core-api logs.
EMAIL_MODE=console
EMAIL_FROM=noreply@ezscreen.io

# Google Calendar + Meet for screening interviews (live mode).
# mock = placeholder Meet URL (default for local dev)
# live = Calendar event + Meet link + Google attendee invites
GOOGLE_MEET_MODE=mock
GOOGLE_CALENDAR_ID=primary
# all | externalOnly | none — "all" emails calendar invites to attendees
GOOGLE_CALENDAR_SEND_UPDATES=all

# Option A — OAuth (dev / single organizer account):
# 1. Enable Google Calendar API in GCP
# 2. OAuth consent screen + scope: https://www.googleapis.com/auth/calendar.events
# 3. Create Desktop OAuth client, then run (use venv on Ubuntu — see GOOGLE_CALENDAR_SETUP.md):
#    python3 -m venv .venv-oauth && source .venv-oauth/bin/activate
#    pip install google-auth-oauthlib google-auth
#    python scripts/google_oauth_refresh_token.py --client-secrets /home/josh/Downloads/
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=

# Option B — Service account (production / Workspace):
# Domain-wide delegation scope: https://www.googleapis.com/auth/calendar.events
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
# GOOGLE_MEET_DELEGATED_USER=scheduler@yourdomain.com

# Full setup guide: docs/integrations/GOOGLE_CALENDAR_SETUP.md
