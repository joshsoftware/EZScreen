# Copy to .env and fill in real values. Do not commit .env.
#
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# JWT_SECRET=generate-a-long-random-string

DATABASE_URL=postgresql://ezscreen_user:CHANGE_ME@db:5432/ezscreen_db
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MinIO / S3 (For core-api, MUST use localhost:9000 to match the browser's Host header)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_password
MINIO_SECURE=false
MINIO_BUCKET_RESUMES=resumes

# Internal parsing service (resume extraction)
PARSING_SERVICE_URL=http://ai-core-services:8002/internal/v1
