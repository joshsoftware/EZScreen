# Copy to services/ai-core-services/.env — do not commit .env.
# Docker Compose loads this file via env_file (see docker-compose.yml).

SERVICE_NAME=ai-core-services
PORT=8002
ENVIRONMENT=development
LOG_LEVEL=INFO

# Use https://ollama.com (not https://api.ollama.com — 301 on POST).
OLLAMA_URL=https://ollama.com
OLLAMA_MODEL=gemma4:31b
OLLAMA_API_KEY=your_ollama_cloud_api_key

ATTENDEE_API_KEY=
ATTENDEE_API_URL=https://api.attendee.dev/v1

# --- Native run ---
# DATABASE_URL=postgresql://ezscreen_user:CHANGE_ME@127.0.0.1:5432/ezscreen_db
# MINIO_ENDPOINT=127.0.0.1:9000

# --- Docker Compose ---
# Host Postgres: postgresql://USER:PASS@host.docker.internal:5432/ezscreen_db
# Encode @ in the password as %40.
DATABASE_URL=postgresql://ezscreen_user:ezscreen_password@db:5432/ezscreen_db

# Server-side only — Docker DNS name is OK (no browser).
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_password
MINIO_SECURE=false
MINIO_BUCKET_NAME=resumes
