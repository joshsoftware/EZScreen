# Copy to .env and fill in real values. Do not commit .env.

# Service Configuration
SERVICE_NAME=ai-core-services
PORT=8002
LOG_LEVEL=INFO
ENVIRONMENT=development

# Database Connection
DATABASE_URL=postgresql://ezscreen_user:CHANGE_ME@db:5432/ezscreen_db

# MinIO / S3 (For ai-core-services, MUST use minio:9000 to resolve inside Docker network)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_password
MINIO_SECURE=false
MINIO_BUCKET_NAME=resumes

# Ollama Cloud LLM Credentials & Configuration
OLLAMA_URL=https://ollama.com
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_API_KEY=YOUR_OLLAMA_API_KEY

# Attendee.dev Meeting Bot Credentials
ATTENDEE_API_KEY=YOUR_ATTENDEE_API_KEY
ATTENDEE_API_URL=https://app.attendee.dev
WEBSOCKET_URL=wss://dummy-ezscreen.ngrok.io/audio
