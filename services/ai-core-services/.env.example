# EZScreen AI Core Services Configuration (.env.example)

# Service Settings
SERVICE_NAME=ai-core-services
PORT=8002
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM Engine (Ollama / Gemma4:31b)
OLLAMA_HOST=
MODEL_NAME=gemma4:31b
LLM_TEMPERATURE=0.2

# Attendee.dev Meeting Bot Credentials
ATTENDEE_API_KEY=attendee_api_key
ATTENDEE_API_URL=https://api.attendee.dev/v1

# PostgreSQL Database Connection
DATABASE_URL=

# Object Storage (MinIO)
