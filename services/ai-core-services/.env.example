# EZScreen AI Core Services Configuration (.env.example)

# Service Settings
SERVICE_NAME=ai-core-services
PORT=8002
ENVIRONMENT=development
LOG_LEVEL=INFO

# Ollama Cloud LLM Credentials & Configuration
OLLAMA_URL=https://api.ollama.com
OLLAMA_MODEL=gemma4:31b
OLLAMA_API_KEY=ollama_api_key

# Attendee.dev Meeting Bot Credentials
ATTENDEE_API_KEY=your_attendee_api_key_here
ATTENDEE_API_URL=https://api.attendee.dev/v1

# PostgreSQL Database Connection
DATABASE_URL=

# Object Storage (MinIO)
