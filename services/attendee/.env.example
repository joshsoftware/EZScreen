# Generated secrets — replace by running:
#   docker compose -f dev.docker-compose.yaml run --rm attendee-app-local python init_env.py
CREDENTIALS_ENCRYPTION_KEY=
DJANGO_SECRET_KEY=

# --- Object storage: EZScreen MinIO (not AWS) ---
# Reuse credentials from services/ai-core-services/.env (MINIO_ACCESS_KEY / MINIO_SECRET_KEY).
STORAGE_PROTOCOL=s3
AWS_RECORDING_STORAGE_BUCKET_NAME=attendee-recordings
AWS_ACCESS_KEY_ID=minio_admin
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=us-east-1
# Preferred for EZScreen local: reach MinIO via host-published port (9002).
# Keeps Attendee independent of Docker bridge/DNS to the EZScreen compose network.
AWS_ENDPOINT_URL=http://host.docker.internal:9002
# Alternative when Attendee shares ezscreen_default and bridge networking works:
# AWS_ENDPOINT_URL=http://minio:9000
AWS_S3_ADDRESSING_STYLE=path

# Hostnames ai-core / browsers may use when calling Attendee (UI on :8003).
ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal,attendee-app-local,*
SITE_DOMAIN=localhost:8003

# Allow http:// webhook URLs so ai-core can be reached at host.docker.internal:8002.
# Bot creation rejects non-https webhooks while this is true (default).
REQUIRE_HTTPS_WEBHOOKS=false
